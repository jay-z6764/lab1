#include <stdio.h>
#include <math.h>

int main()
{
    double x, y, A, B, U;

    for (y = 2; y <= 4; y = y + 1.5)
    {
        for (x = 1; x <= 3; x = x + 1.3)
        {
            if (x / (y * y) < 1)
            {
                A = exp(1) * cos(3.1415926 * x * x) - y;

                B = tan(cbrt(x * y * y) - 1 / sqrt(x));

                if (A > B)
                    U = A;
                else
                    U = B;
            }
            else
            {
                U = sin(x * y - x * x - y * y);
            }

            printf("x = %.1f  y = %.1f  U = %.4f\n", x, y, U);
        }
    }

    return 0;
}
